{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ready Player Two",
  "version": "1.0.70",
  "identifier": "com.readyplayerone.ready-player-two",
  "build": { "frontendDist": "../frontend" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "Ready Player Two 1.0.70", "width": 1000, "height": 680, "minWidth": 640, "minHeight": 420, "maximized": true, "center": true, "visible": true, "focus": true }],
    "security": { "csp": "default-src 'self'; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:" }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico"] }
}
