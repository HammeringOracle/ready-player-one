{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ready Player One",
  "version": "1.0.415",
  "identifier": "com.batocera.warehouse",
  "build": {
    "devUrl": "http://localhost:8789",
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Ready Player One",
        "url": "http://localhost:8789",
        "width": 1440,
        "height": 900,
        "maximized": true,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"],
    "resources": {
      "../ui": "ui",
      "../companions/ready-player-two/vendor/refind": "companions/ready-player-two/vendor/refind",
      "../frontend": "frontend",
      "../Ready Player One.html": "Ready Player One.html",
      "../node.exe": "node.exe",
      "../node_modules": "node_modules",
      "../installers": "installers",
      "../output/pdf/ready-player-one-program-topology-v4.pdf": "output/pdf/ready-player-one-program-topology-v4.pdf",
      "../package.json": "package.json"
    }
  }
}
