{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ready Player One",
  "version": "1.0.246",
  "identifier": "com.batocera.warehouse",
  "build": {
    "beforeDevCommand": "node ui/start-server.js",
    "devUrl": "http://localhost:8789",
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [
      {
        "title": "Ready Player One",
        "url": "http://localhost:8789",
        "width": 1440,
        "height": 900,
        "maximized": true,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"],
    "resources": {
      "../ui": "ui",
      "../frontend": "frontend",
      "../Ready Player One.html": "Ready Player One.html",
      "../package.json": "package.json"
    }
  }
}
